# LLM (OpenAI-compatible): shortening, consistency check, and optional audio tags
LLM_PROVIDER=openrouter-ai
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1/
LLM_MODEL=choose_your_model

# ElevenLabs: only needed with --tts-provider elevenlabs (audio tags require eleven_v3)
TTS_API_KEY=your_api_key
TTS_BASE_URL=https://api.elevenlabs.io/v1/
TTS_MODEL=eleven_v3
TTS_VOICE_ID=your_voice_id

# VoxCPM (default TTS): optional overrides
# VOXCPM_MODEL=mlx-community/VoxCPM2-4bit
# VOXCPM_VOICE_DIR=voices
